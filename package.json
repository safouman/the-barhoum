{
  "name": "the-barhoum",
  "version": "1.0.0",
  "description": "Barhoum personal coaching site",
  "private": true,
  "scripts": {
    "start:dev": "next dev",
    "build": "node --version && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint -- --max-warnings=0 && npm run typecheck",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "analyze-audio": "node scripts/analyze-audio.mjs",
    "transcode:video": "node scripts/transcode-video.mjs",
    "payload": "node --env-file-if-exists=.env.local ./node_modules/payload/bin.js --disable-transpile",
    "payload:migrate": "PAYLOAD_MIGRATING=1 npm run payload -- migrate"
  },
  "keywords": [
    "coaching",
    "nextjs",
    "rtl"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-resend": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-vercel-blob": "3.93.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/blob": "2.6.1",
    "@vercel/oidc": "4.0.7",
    "@vimeo/player": "2.30.4",
    "classnames": "^2.5.1",
    "graphql": "16.15.0",
    "hls.js": "^1.6.13",
    "next": "16.4.5",
    "openid-client": "6.8.8",
    "payload": "3.93.0",
    "posthog-js": "^1.290.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^9.1.0",
    "stripe": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vimeo__player": "2.18.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "node scripts/run-eslint.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/blob": {
      "@vercel/oidc": "$@vercel/oidc"
    },
    "@lexical/headless": {
      "happy-dom": "21.0.4"
    },
    "monaco-editor": {
      "dompurify": "3.4.17"
    },
    "browserslist": "4.29.5",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.4",
    "preact@10": "10.27.3",
    "source-map-js": "1.2.2",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "glob@10": "10.5.0",
    "minimatch@9": "9.0.9"
  }
}
